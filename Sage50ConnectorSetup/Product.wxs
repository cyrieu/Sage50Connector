<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Rutter Sage 50 Connector"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="Rutter"
           UpgradeCode="{D7F3C026-081A-4C0A-9F17-AA4EAEE4A9B7}">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x86" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. If you have a newer version installed you can uninstall it, or provision this machine with 'Sage50Connector.exe --setup' instead." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="Sage50Icon.ico" SourceFile="$(var.Sage50Connector.ProjectDir)Sage_50cloud_logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="Sage50Icon.ico" />

    <Feature Id="ProductFeature" Title="Rutter Sage 50 Connector" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Installer UI: standard install-dir flow + the Sage connection-details dialog (ConfigDlg.wxs) -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Deferred custom action that writes sage50Config.json from COMPANYNAME/ACCESSKEY/CONNECTIONID -->
    <Binary Id="WriteSageConfigJsonCA"
            SourceFile="$(var.Sage50ConnectorSetupCustomActions.TargetDir)$(var.Sage50ConnectorSetupCustomActions.TargetName).CA.dll" />
    <CustomAction Id="SetWriteSageConfigJson"
                  Property="WriteSageConfigJson"
                  Value="CompanyName=[COMPANYNAME];AccessKey=[ACCESSKEY];ConnectionId=[CONNECTIONID]"
                  Execute="immediate" />
    <CustomAction Id="WriteSageConfigJson"
                  BinaryKey="WriteSageConfigJsonCA"
                  DllEntry="WriteSageConfigJson"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="SetWriteSageConfigJson" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="WriteSageConfigJson" After="SetWriteSageConfigJson">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Rutter Sage 50 Connector" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Console/provisioning tool + shared runtime deps come from the connector project
           output (the service project does not copy all transitive packages.config deps). -->
      <Component Id="Sage50ConnectorExe" Guid="{EC37D31E-8776-4583-8FDA-DAFCA5A739C4}">
        <File Id="Sage50Connector.exe"
              Source="$(var.Sage50Connector.TargetDir)Sage50Connector.exe"
              KeyPath="yes" />
      </Component>
      <!--
        Start the tray app when a user logs on. This is deliberately how the
        connector runs rather than as a Windows service: Sage records third-party
        access per Windows user, so running in the logged-on user's session means
        the connector is automatically the identity that approved it. A service
        had to be given that user's credentials to achieve the same thing.

        The trade-off is that syncing only happens while someone is logged in.
      -->
      <Component Id="Sage50ConnectorAutostart" Guid="{9E1D7C4A-3B62-4F0E-9C21-7D5A1E8B4C33}">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="RutterSage50Connector"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]Sage50Connector.exe&quot;"
                       KeyPath="yes" />
      </Component>
      <Component Id="NewtonsoftJson" Guid="{1F2DA1C6-B49D-4255-9915-5C4235633D57}">
        <File Id="Newtonsoft.Json.dll" Source="$(var.Sage50Connector.TargetDir)Newtonsoft.Json.dll" KeyPath="yes" />
      </Component>
      <Component Id="SagePeachtreeApi" Guid="{68D97B2B-D0F0-4D71-8334-BFD532CF5F32}">
        <File Id="Sage.Peachtree.API.dll" Source="$(var.Sage50Connector.TargetDir)Sage.Peachtree.API.dll" KeyPath="yes" />
      </Component>
      <Component Id="SagePeachtreeApiResolver" Guid="{22F64079-896B-4789-98FC-01FDC6D48173}">
        <File Id="Sage.Peachtree.API.Resolver.dll" Source="$(var.Sage50Connector.TargetDir)Sage.Peachtree.API.Resolver.dll" KeyPath="yes" />
      </Component>
      <Component Id="BclAsyncInterfaces" Guid="{4D35751C-6120-437F-922F-506D65008C90}">
        <File Id="Microsoft.Bcl.AsyncInterfaces.dll" Source="$(var.Sage50Connector.TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemBuffers" Guid="{2040A69E-5DBE-47C2-8146-83B0B67DD131}">
        <File Id="System.Buffers.dll" Source="$(var.Sage50Connector.TargetDir)System.Buffers.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemDiagnosticsEventLog" Guid="{10965190-ACA1-43B0-8936-445A9E94E660}">
        <File Id="System.Diagnostics.EventLog.dll" Source="$(var.Sage50Connector.TargetDir)System.Diagnostics.EventLog.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemDiagnosticsPerformanceCounter" Guid="{0AE206B3-1DDB-4599-9FEA-B82EE44D53D4}">
        <File Id="System.Diagnostics.PerformanceCounter.dll" Source="$(var.Sage50Connector.TargetDir)System.Diagnostics.PerformanceCounter.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemMemory" Guid="{312B9AD9-A212-4372-B04C-8439C8FDF89A}">
        <File Id="System.Memory.dll" Source="$(var.Sage50Connector.TargetDir)System.Memory.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemNumericsVectors" Guid="{5D2E7BF4-520C-4D7E-8CCB-8C7A7A5FD662}">
        <File Id="System.Numerics.Vectors.dll" Source="$(var.Sage50Connector.TargetDir)System.Numerics.Vectors.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemRuntimeCompilerServicesUnsafe" Guid="{221D8D40-E52C-459C-9F09-71110EFB6B05}">
        <File Id="System.Runtime.CompilerServices.Unsafe.dll" Source="$(var.Sage50Connector.TargetDir)System.Runtime.CompilerServices.Unsafe.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemSecurityPrincipalWindows" Guid="{FA6C13EC-FA92-4598-BE75-B61D4851E2F3}">
        <File Id="System.Security.Principal.Windows.dll" Source="$(var.Sage50Connector.TargetDir)System.Security.Principal.Windows.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemTextEncodingsWeb" Guid="{5EDB658C-6FA9-4CAC-8FD8-E6176277A244}">
        <File Id="System.Text.Encodings.Web.dll" Source="$(var.Sage50Connector.TargetDir)System.Text.Encodings.Web.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemTextJson" Guid="{85CF5B2C-2009-4628-9192-424A10713DF6}">
        <File Id="System.Text.Json.dll" Source="$(var.Sage50Connector.TargetDir)System.Text.Json.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemThreadingTasksExtensions" Guid="{4F88BCCE-702E-4C29-8C76-910F1F8BDACF}">
        <File Id="System.Threading.Tasks.Extensions.dll" Source="$(var.Sage50Connector.TargetDir)System.Threading.Tasks.Extensions.dll" KeyPath="yes" />
      </Component>
      <Component Id="SystemValueTuple" Guid="{0CF3D46E-6A46-4DD0-9A78-6AEBC00BBE5E}">
        <File Id="System.ValueTuple.dll" Source="$(var.Sage50Connector.TargetDir)System.ValueTuple.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
