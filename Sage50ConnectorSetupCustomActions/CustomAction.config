<?xml version="1.0" encoding="utf-8"?>
<!--
  SfxCA.dll is a native stub that hosts the CLR to run the managed custom
  action. It defaults to the v2 runtime, so a custom action targeting .NET
  Framework 4.x fails at load with:

    Error: could not load custom action class
    Sage50ConnectorSetupCustomActions.CustomActions from assembly:
    Sage50ConnectorSetupCustomActions

  which surfaces as MSI 1603 with no other explanation. MakeSfxCA packs this
  file as the app config when it is passed in the input list.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
