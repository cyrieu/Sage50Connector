<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{FAAF6BD0-6308-4E4A-B9ED-192B3AE5BD49}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Sage50ConnectorSetupCustomActions</RootNamespace>
    <AssemblyName>Sage50ConnectorSetupCustomActions</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.Deployment.WindowsInstaller ships with the WiX Toolset v3.11 SDK -->
    <Reference Include="Microsoft.Deployment.WindowsInstaller">
      <HintPath>$(MSBuildProgramFiles32)\WiX Toolset v3.11\SDK\Microsoft.Deployment.WindowsInstaller.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CustomActions.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    Pack the managed CA into an unmanaged SFX custom-action DLL that MSI can
    load. VS/WiX "PackProject" does this for Votive builds; command-line
    MSBuild needs an explicit MakeSfxCA step.
  -->
  <Target Name="PackCustomAction" AfterTargets="Build">
    <PropertyGroup>
      <WixSdkDir>$(MSBuildProgramFiles32)\WiX Toolset v3.11\SDK</WixSdkDir>
      <MakeSfxCAExe>$(WixSdkDir)\MakeSfxCA.exe</MakeSfxCAExe>
      <SfxCADll>$(WixSdkDir)\x86\sfxca.dll</SfxCADll>
      <WindowsInstallerDll>$(WixSdkDir)\Microsoft.Deployment.WindowsInstaller.dll</WindowsInstallerDll>
      <PackedCustomAction>$(TargetDir)$(TargetName).CA.dll</PackedCustomAction>
    </PropertyGroup>
    <Error Condition="!Exists('$(MakeSfxCAExe)')"
           Text="MakeSfxCA.exe not found at '$(MakeSfxCAExe)'. Install WiX Toolset v3.11 SDK/build tools." />
    <Error Condition="!Exists('$(SfxCADll)')"
           Text="sfxca.dll not found at '$(SfxCADll)'." />
    <Exec Command="&quot;$(MakeSfxCAExe)&quot; &quot;$(PackedCustomAction)&quot; &quot;$(SfxCADll)&quot; &quot;$(TargetPath)&quot; &quot;$(WindowsInstallerDll)&quot;" />
    <Message Importance="high" Text="Packed custom action: $(PackedCustomAction)" />
  </Target>
</Project>
